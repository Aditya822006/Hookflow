# Project Settings
PROJECT_NAME=HookFlow
VERSION=1.0.0
API_V1_STR=/api/v1

# Database Configuration
# Local SQLite fallback: sqlite:///./hookflow.db
# Docker defaults; change these if reusing an existing PostgreSQL volume.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=hookflow_db
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@postgres:5432/hookflow_db

# Message Broker & Celery Worker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_ALWAYS_EAGER=False

# Webhook Delivery & Retry Policy
MAX_DELIVERY_RETRIES=3
RETRY_BACKOFF_BASE_SECONDS=5
WEBHOOK_TIMEOUT_SECONDS=10

# Security
WEBHOOK_SECRET_KEY=hookflow-super-secret-key-change-in-production-32chars
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
